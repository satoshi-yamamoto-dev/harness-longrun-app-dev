{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satoshi-yamamoto-dev.github.io/harness-longrun-app-dev/schemas/product-spec.schema.json",
  "title": "Product specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "specId", "title", "summary", "background", "targetUsers", "problems", "scenarios", "features", "nonFunctionalRequirements", "data", "externalIntegrations", "uxPrinciples", "constraints", "acceptanceCriteria", "aiAssessment"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "specId": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "summary": { "$ref": "#/$defs/text" },
    "background": { "$ref": "#/$defs/text" },
    "targetUsers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/targetUser" } },
    "problems": { "$ref": "#/$defs/textArray" },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
    "features": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" } },
    "nonFunctionalRequirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "data": { "type": "array", "items": { "$ref": "#/$defs/dataRequirement" } },
    "externalIntegrations": { "type": "array", "items": { "$ref": "#/$defs/integration" } },
    "uxPrinciples": { "$ref": "#/$defs/textArray" },
    "constraints": { "$ref": "#/$defs/textArray" },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptanceCriterion" } },
    "aiAssessment": { "$ref": "#/$defs/aiAssessment" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "textArray": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
    "targetUser": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "needs"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" }, "needs": { "$ref": "#/$defs/textArray" } }
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["id", "actorId", "goal", "steps", "expectedOutcome"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "actorId": { "$ref": "#/$defs/id" }, "goal": { "$ref": "#/$defs/text" }, "steps": { "$ref": "#/$defs/textArray" }, "expectedOutcome": { "$ref": "#/$defs/text" } }
    },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["id", "description"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" }, "rationale": { "$ref": "#/$defs/text" } }
    },
    "feature": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "priority", "acceptanceCriterionIds"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" }, "rationale": { "$ref": "#/$defs/text" }, "priority": { "enum": ["must", "should", "could"] }, "acceptanceCriterionIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true } }
    },
    "dataRequirement": {
      "type": "object", "additionalProperties": false, "required": ["id", "entity", "description"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "entity": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" }, "attributes": { "type": "object" } }
    },
    "integration": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "purpose", "required"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "purpose": { "$ref": "#/$defs/text" }, "required": { "type": "boolean" } }
    },
    "acceptanceCriterion": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "verification"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" }, "verification": { "$ref": "#/$defs/text" } }
    },
    "aiAssessment": {
      "type": "object", "additionalProperties": false, "required": ["adopted", "rationale", "tasks"],
      "properties": { "adopted": { "type": "boolean" }, "rationale": { "$ref": "#/$defs/text" }, "tasks": { "type": "array", "items": { "$ref": "#/$defs/aiTask" } } }
    },
    "aiTask": {
      "type": "object", "additionalProperties": false, "required": ["id", "instruction", "tools", "expectedStateChanges", "acceptanceCriterionIds"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "instruction": { "$ref": "#/$defs/text" }, "tools": { "$ref": "#/$defs/textArray" }, "expectedStateChanges": { "$ref": "#/$defs/textArray" }, "acceptanceCriterionIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true } }
    }
  }
}
