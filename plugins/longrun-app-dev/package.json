    "validate:schemas": "node scripts/validate-schemas.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "typescript": "catalog:",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "@playwright/mcp": "0.0.80"
  }
}
