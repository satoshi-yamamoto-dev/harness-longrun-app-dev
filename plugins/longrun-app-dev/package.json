{
  "name": "@harness-tools/longrun-app-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "longrun-app-dev": "bin/longrun-app-dev"
  },
  "files": [
    ".claude-plugin/",
    "agents/",
    "bin/",
    "LICENSE",
    "prompts/",
    "rubrics/",
    "runtime/dist/",
    "schemas/",
    "skills/",
    "templates/"
  ],
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "test": "pnpm build && pnpm test:unit",
